@{ ViewData["Title"] = "Cấp hợp đồng bảo hiểm"; var insurers = (List<Insurer>)ViewBag.Insurers; }
<div class="card" style="max-width:760px"><div class="card-body">
    @if (insurers.Count == 0) { <div class="alert alert-warning">Chưa có công ty BH. <a href="/Insurer">Thêm</a> trước.</div> }
    else
    {
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div class="row g-3">
                <div class="col-md-6"><label class="form-label small text-muted">Khách hàng *</label><input name="customerName" class="form-control" required /></div>
                <div class="col-md-6"><label class="form-label small text-muted">SĐT</label><input name="customerPhone" class="form-control" /></div>
                <div class="col-md-4"><label class="form-label small text-muted">Biển số *</label><input name="vehiclePlate" class="form-control" required /></div>
                <div class="col-md-8"><label class="form-label small text-muted">Mẫu xe</label><input name="vehicleModel" class="form-control" /></div>
                <div class="col-md-5"><label class="form-label small text-muted">Công ty BH *</label>
                    <select name="insurerId" class="form-select" required><option value="">— Chọn —</option>@foreach (var i in insurers) { <option value="@i.Id">@i.Name</option> }</select></div>
                <div class="col-md-7"><label class="form-label small text-muted">Loại bảo hiểm</label>
                    <select name="type" class="form-select">@foreach (InsuranceType t in Enum.GetValues(typeof(InsuranceType))) { <option value="@((int)t)">@Ui.Type(t)</option> }</select></div>
                <div class="col-md-6"><label class="form-label small text-muted">Số tiền bảo hiểm</label><input name="sumInsured" type="number" step="1000000" class="form-control" /></div>
                <div class="col-md-6"><label class="form-label small text-muted">Phí bảo hiểm</label><input name="premium" type="number" step="10000" class="form-control" /></div>
                <div class="col-md-6"><label class="form-label small text-muted">Từ ngày</label><input name="startDate" type="date" value="@DateTime.Today.ToString("yyyy-MM-dd")" class="form-control" /></div>
                <div class="col-md-6"><label class="form-label small text-muted">Đến ngày</label><input name="endDate" type="date" value="@DateTime.Today.AddYears(1).ToString("yyyy-MM-dd")" class="form-control" /></div>
                <div class="col-12"><label class="form-label small text-muted">Ghi chú</label><input name="note" class="form-control" /></div>
            </div>
            <div class="mt-3"><button class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Cấp hợp đồng</button> <a href="/Policy" class="btn btn-outline-secondary">Hủy</a></div>
        </form>
    }
</div></div>
